{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake Configure",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-B",
        "build"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Build Game",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "build",
        "--target",
        "cab_game"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Build Tests",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "build",
        "--target",
        "cab_test"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Run Tests",
      "type": "shell",
      "command": "ctest",
      "args": [
        "--test-dir",
        "build",
        "--output-on-failure"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "dependsOn": "Build Tests",
      "problemMatcher": []
    },
    {
      "label": "Build App",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "build",
        "--target",
        "${input:appName}"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Run Example App",
      "type": "shell",
      "command": "${workspaceFolder}/build/${input:appName}.exe",
      "dependsOn": "Build App",
      "problemMatcher": []
    },
    {
      "label": "Build Static Library",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "build",
        "--target",
        "cab_core"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Rebuild",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "build",
        "--clean-first"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Clean",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "build",
        "--target",
        "clean"
      ],
      "group": "build",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "appName",
      "type": "promptString",
      "description": "Enter app name from apps/ (e.g. simplest_example, 6_letters_example):",
      "default": "simplest_example"
    }
  ]
}